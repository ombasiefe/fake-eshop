generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider = "mysql"
}

model products {
  id          Int         @id @default(autoincrement())
  title       String      @unique
  description String      @db.Text
  price       Float
  image       String      @unique
  isActive    Boolean     @default(false)
  categoryId  Int
  orderitem   orderitem[]
  category    categories  @relation(fields: [categoryId], references: [id])

  @@index([categoryId], map: "products_categoryId_fkey")
}

model categories {
  id       Int        @id @default(autoincrement())
  name     String     @unique
  products products[]
}

model orderitem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  price     Float
  orders    orders   @relation(fields: [orderId], references: [id], onDelete:Cascade, map: "OrderItem_orderId_fkey")
  products  products @relation(fields: [productId], references: [id], map: "OrderItem_productId_fkey")

  @@index([orderId], map: "OrderItem_orderId_fkey")
  @@index([productId], map: "OrderItem_productId_fkey")
}

model orders {
  id         Int           @id @default(autoincrement())
  email      String
  tel        String
  userId     Int
  address    String
  firstName  String
  lastName   String
  postalCode String
  createdAt  DateTime      @default(now())
  Status     orders_Status @default(pending)
  items      orderitem[]
  user       user          @relation(fields: [userId], references: [id], map: "Orders_userId_fkey")

  @@index([userId], map: "Orders_userId_fkey")
}

model user {
  id       Int      @id @default(autoincrement())
  email    String   @unique(map: "User_email_key")
  password String
  isAdmin  Boolean  @default(false)
  orders   orders[]
}

model notifications{
  id Int @id @default(autoincrement())
  from String @default("contact_form")
  email String
  name String 
  surname String
  tel String
  reason String 
  message String @db.Text
  isRead Boolean @default(false)
}

view orderschartdata {
  date         DateTime? @db.Date
  orders       Int    @default(0)
  total_income Float?
}

view orderstatuschart {
  Status orderstatuschart_Status @default(pending)
  count  Int                  @default(0)
}

view productsbycategorychartdata {
  name  String
  count Int @default(0)
}

enum orders_Status {
  pending
  working_on_it
  on_the_way
  delivered
  canceled
}

enum orderstatuschart_Status {
  pending
  working_on_it
  on_the_way
  delivered
  canceled
}
